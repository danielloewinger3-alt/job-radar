# Copy this file to .env and fill in whichever keys you sign up for.
# Greenhouse, Lever and RemoteOK need no key and work out of the box.

# How often to re-poll all sources, in minutes.
POLL_INTERVAL_MINUTES=60

# Adzuna (free tier): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed (UK jobs, free): https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# USAJobs (US federal jobs, free): https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=danielloewinger3@gmail.com

# GitHub, for the Dossier's GitHub tab.
# Username alone shows your public repos, no auth needed.
GITHUB_USERNAME=
# Add a personal access token (classic, "repo" scope) to also show private repos.
# Create one at https://github.com/settings/tokens — treat it like a password.
GITHUB_TOKEN=

# AI-assisted applications (job modal "Apply" tab): Claude drafts the cover letter,
# GPT reviews it for how human it sounds, Claude revises. Both keys are required.
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Override if the default model name below 404s for your account.
OPENAI_MODEL=gpt-5

# Companies House (free, UK only) — filing-health signal for Prospects mode
# (overdue accounts / dissolved status). Only covers incorporated businesses;
# sole traders won't show up. https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# ---------- Future workstreams (no configuration needed this sprint) ----------
# Project-file store limits (size / count / extracted-text caps, upload allowlist)
# and the outreach crawler's page and delay limits are set in backend/config.py,
# not here. The browser-extension CORS allowlist (the two exact localhost origins
# plus the chrome-extension:// ID shape) is fixed in backend/main.py.
# This project uses no SMTP or email credentials.
